Options -MultiViews
RewriteEngine On

# -----------------------------
# 1. ALWAYS IGNORE REST API
# -----------------------------
RewriteCond %{REQUEST_URI} ^/rest/ [NC]
RewriteRule ^ - [L]

# -----------------------------
# 2. Serve real files/folders normally
# -----------------------------
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# -----------------------------
# 3. SPA fallback ONLY for frontend
# -----------------------------
RewriteRule ^ index.html [L]